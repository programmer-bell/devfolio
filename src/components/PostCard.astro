---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  url: string;
  tags?: string[];
}

const { title, description, pubDate, url, tags = [] } = Astro.props;
---

<a href={url} class="card">
  <h2>{title}</h2>
  <p class="muted">{pubDate.toDateString()}</p>
  <p>{description}</p>
  {tags.length > 0 && (
    <div class="tags">
      {tags.map((tag: string) => (
        <span class="tag">{tag}</span>
      ))}
    </div>
  )}
</a>