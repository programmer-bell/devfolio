---
import { site } from "../data/site";
---

<header>
    <nav class="container">
        <a href="/" class="logo">{site.name}</a>
        <div class="links">
            <a href="/">Home</a>
            <a href="/about">About</a>
            <a href="/blog">Blog</a>
        </div>
    </nav>
</header>

<style>
    nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 20px;
    }
    .link { display: flex; align-items: center; gap: 20px; }
    .logo { font-weight: 700; color: var(--text);}
</style>