---
import BasLayout from "../layout/BasLayout.astro";
import { site } from "../data/site";

type Social = (typeof site.socials)[number];
---

<BasLayout title="Home">
	<section class="hero">
	<h1>Hi, I'm {site.name} 👋</h1>
	<p>{site.role}</p>
	<p>{site.bio}</p>
	{site.opentowork && <p><span class="tag">✅ Open to work</span></p>}
	<ul class="socials">
		{site.socials.map((social: Social) => (
		<li>
			<a href={social.url}>{social.label}</a>
		</li>
		))}
	</ul>
	<a href="/blog" class="btn">Read my blog</a>
	</section>
</BasLayout>

