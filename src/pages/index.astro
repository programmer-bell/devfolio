---
import BasLayout from "../layout/BasLayout.astro";
import { site } from "../data/site";
---

<BasLayout title="Home">
	<section class="hero">
	<h1>Hi, I'm {site.name} 👋</h1>
	<p>{site.role}</p>
	<p>{site.bio}</p>
	{site.opentowork && <span>✅ Open to work</span>}
	<ul class="socials">
		{site.socials.map( (social) => (
		<li>
			<a href={social.url}>{social.label}</a>
		</li>
		))}
	</ul>
	<a href="/blog" class="btn">Read my block</a>
	</section>
</BasLayout>

