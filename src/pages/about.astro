---
import BasLayout from "../layout/BasLayout.astro";
import { site } from "../data/site";
const skills = ["HTML", "CSS", "JS", "Astro"];
---
<BasLayout title="About">
    <h1>About Me</h1>
    <p>{site.bio}</p>
    <h2>Skills</h2>
    <div class="tags">
    {skills.map( (skill) => (
        <span>{skill}</span>
    ))}
    </div>

</BasLayout>
